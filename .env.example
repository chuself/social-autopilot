# ── Meta (required to post) ────────────────────────────────────────────────
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=      # a PAGE token, not a user token
IG_USER_ID=                # the IG Business account id, not the @handle

# ── Public asset host (required — Instagram fetches the image server-side) ──
PUBLIC_ASSET_BASE=https://operra-social.pages.dev

# ── Brain (at least one) ───────────────────────────────────────────────────
GEMINI_API_KEY=            # aistudio.google.com — free tier, also does the images
GROQ_API_KEY=              # optional fallback if Gemini quota runs out

# ── Optional free image fallback ───────────────────────────────────────────
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ── Safety ─────────────────────────────────────────────────────────────────
DRY_RUN=1                  # 1 = render and log only, never call a post API
AUTO_APPROVE_HOURS=24      # pending posts go out after this long unless rejected
POST_HOUR=9                # local hour posts are scheduled for
# MOCK_LLM=1               # canned copy, no API key needed — for testing the pipeline
# SKIP_IMAGE=1             # skip AI backgrounds, use the branded gradient
